# ===== Autenticação =====
# Este token será usado tanto na API vLLM quanto na Open WebUI
VLLM_API_KEY=troque-este-token-forte

# ===== Modelo / execução =====
# Produção (GPU robusta): openai/gpt-oss-20b
# Alternativas (menos VRAM): Qwen/Qwen2.5-7B-Instruct-AWQ, meta-llama/Llama-3.1-8B-Instruct-AWQ, etc.
MODEL_ID=openai/gpt-oss-20b

# Quantização (opcional) — use somente se o checkpoint for compatível
# Valores comuns: awq | gptq  (deixe em branco para rodar sem quantização)
QUANTIZATION=

# Contexto e uso de VRAM (ajuste conforme a GPU)
MAX_MODEL_LEN=131072
GPU_MEMORY_UTILIZATION=0.9

# Paralelismo por múltiplas GPUs (mesmo nó)
TENSOR_PARALLEL_SIZE=1

# ===== GPUs e imagem =====
GPUS=all
CUDA_VISIBLE_DEVICES=             # ex.: 0 ou 0,1
VLLM_IMAGE_TAG=latest             # ex.: v0.7.1 se quiser fixar versão

# ===== Portas =====
HOST_VLLM_PORT=8000
VLLM_PORT=8000
HOST_WEBUI_PORT=3000

# ===== Open WebUI =====
WEBUI_AUTH=true
ENABLE_MODEL_SELECTOR=true

# ===== Tuning opcional =====
MAX_SPLIT_SIZE_MB=128
EXTRA_VLLM_FLAGS=                 # ex.: "--enable-chunked-prefill --max-num-batched-tokens 8192"